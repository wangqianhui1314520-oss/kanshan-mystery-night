/* ============================================================
 * 求真档案局 · 看山失踪夜 —— 深色档案局 HUD + 知乎蓝 #0084FF
 * 规约：真图 content/assets/images + CSS/SVG 手绘；零外链；移动端适配。
 * ============================================================ */
:root {
  --bg: #070b14;
  --bg2: #0b1120;
  --panel: rgba(13, 20, 38, .92);
  --panel2: rgba(17, 26, 48, .85);
  --line: rgba(0, 132, 255, .28);
  --line-dim: rgba(90, 130, 200, .16);
  --blue: #0084ff;
  --blue-2: #4da8ff;
  --cyan: #6fe3ff;
  --gold: #f5c451;
  --green: #00e5a8;
  --red: #ff4d5e;
  --purple: #a58bff;
  --txt: #dbe6fa;
  /* 正文辅助色：深底 #0b1120 上对比度 ≈ 6.0:1（≥4.5:1，正文可读） */
  --txt-dim: #97abd2;
  --txt-mute: #7f93ba;
  --mono: Consolas, "JetBrains Mono", monospace;
  /* ---- 体验层统一token（间距/字号/圆角/时长） ---- */
  --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px;
  --fs-xs: 11px; --fs-sm: 12px; --fs-md: 14px; --fs-lg: 17px;
  --r-sm: 6px; --r-md: 8px; --r-lg: 12px; --r-xl: 16px;
  --t-fast: .12s; --t-base: .18s; --t-slow: .26s;
  --tap: 44px;
  --shadow-card: 0 8px 24px rgba(0, 0, 0, .4);
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; }
#app { height: 100%; }
body {
  background:
    radial-gradient(1200px 500px at 80% -10%, rgba(0, 132, 255, .12), transparent 60%),
    radial-gradient(900px 420px at 0% 110%, rgba(165, 139, 255, .07), transparent 55%),
    var(--bg);
  color: var(--txt);
  font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 14px; line-height: 1.55;
  overflow: hidden;
}
/* 档案局扫描线氛围 */
body::after {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 99; opacity: .5;
  background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(120, 170, 255, .012) 3px 4px);
}
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: #1c2c4e; border-radius: 4px; }
.mono { font-family: var(--mono); }
.dim { color: var(--txt-dim); font-size: 12px; }
.hl { color: var(--cyan); font-style: normal; }
.pad { padding: 12px; }

.goal-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
.rb-actions .goal-entry { flex-shrink:0; color:var(--gold); border-color:var(--gold); }
@media (max-width: 1100px) {
  .app .res-bar { height:auto; min-height:34px; flex-wrap:wrap; overflow:visible; padding:6px 10px; }
  .app .rb-stats { order:3; flex-basis:100%; flex-wrap:wrap; overflow:visible; justify-content:flex-start; }
  .app .rb-actions { flex-wrap:wrap; margin-left:auto; }
  .first-play-card div { flex-wrap:wrap; }
}
/* ---------- 启动屏 ---------- */
.boot-screen { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
.boot-screen img { width: 84px; filter: drop-shadow(0 0 18px rgba(0, 132, 255, .5)); animation: float 3s ease-in-out infinite; }
.boot-screen h1 { font-size: 22px; letter-spacing: 4px; }
.boot-screen p { color: var(--txt-dim); font-family: var(--mono); }
.boot-bar { width: 200px; height: 3px; background: #16223e; border-radius: 2px; overflow: hidden; }
.boot-bar i { display: block; height: 100%; width: 40%; background: var(--blue); border-radius: 2px; animation: bootmove 1.1s ease-in-out infinite; }
@keyframes bootmove { 0% { transform: translateX(-100%);} 100% { transform: translateX(350%);} }
@keyframes float { 0%,100% { transform: translateY(0);} 50% { transform: translateY(-6px);} }

/* ---------- 布局 ---------- */
.app { height: 100%; display: flex; flex-direction: column; }
.main { flex: 1; display: flex; min-height: 0; }
.stage { flex: 1; min-width: 0; overflow: auto; position: relative; }
.view { padding: 18px 20px 40px; animation: viewin .25s ease; }
@keyframes viewin { from { opacity: 0; transform: translateY(6px);} to { opacity: 1; } }

/* ---------- HUD ---------- */
.hud { display: flex; align-items: center; gap: 16px; padding: 10px 16px; border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(10, 16, 32, .96), rgba(9, 14, 28, .88)); position: relative; z-index: 20; }
.hud::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
  background: linear-gradient(90deg, transparent, var(--blue), transparent); opacity: .7; }
.hud-brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.hud-logo { width: 38px; height: 38px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(0,132,255,.45)); }
.hud-title b { display: block; font-size: 15px; letter-spacing: 1px; white-space: nowrap; }
.hud-title span { font-family: var(--mono); font-size: 11px; color: var(--txt-dim); }
.hud-stats { display: flex; gap: 8px; flex-wrap: wrap; flex: 1; justify-content: center; }
.stat { display: flex; flex-direction: column; align-items: center; padding: 3px 12px; border: 1px solid var(--line-dim); border-radius: 6px; background: var(--panel2); min-width: 74px; }
.stat i { font-style: normal; font-size: 10px; color: var(--txt-dim); letter-spacing: 2px; }
.stat b { font-family: var(--mono); font-size: 14px; color: var(--blue-2); }
.stat.heat b { color: var(--green); } .stat.heat.hot b { color: var(--red); animation: pulse 1s infinite; }
.rb-chip.joy{color:#ffd166}.rb-chip.joy.hot{color:#fff3a3;box-shadow:0 0 0 1px rgba(255,209,102,.45)}
.host-console{position:fixed;top:42px;right:18px;z-index:40;display:flex;gap:10px;align-items:center;padding:10px 12px;background:rgba(20,24,35,.96);border:1px solid rgba(255,209,102,.35);border-radius:10px;box-shadow:0 8px 24px #0006}.host-console span{color:var(--txt-dim);font-size:12px}
.goal-card{position:fixed;inset:0;z-index:39;pointer-events:none}.goal-card-inner{pointer-events:auto;position:absolute;top:44px;right:18px;width:min(340px,calc(100vw - 36px));padding:16px;background:rgba(20,24,35,.98);border:1px solid rgba(120,180,255,.4);border-radius:12px;box-shadow:0 12px 32px #0008}.goal-title{font-size:16px;font-weight:700;margin-bottom:12px}.goal-title small{font-size:11px;color:var(--txt-dim);margin-left:6px}.goal-row{display:grid;gap:4px;padding:9px 0;border-top:1px solid #ffffff12;font-size:13px}.goal-row b{color:#9ecbff}.goal-row span{line-height:1.45}.goal-row.faction b{color:#ff9f9f}.goal-row.fun b{color:#ffd166}.goal-hint{margin:12px 0 0;color:var(--txt-dim);font-size:11px}
.first-play-card{margin:14px 0;padding:12px 14px;text-align:left;background:rgba(0,132,255,.1);border:1px solid rgba(0,132,255,.32);border-radius:10px}.first-play-card div{display:flex;justify-content:space-between;gap:10px;align-items:baseline}.first-play-card b{color:#f5c451}.first-play-card span{color:var(--txt-dim);font-size:12px}.first-play-card p{margin:6px 0 0;color:#c9d6ee;font-size:12px}
.stat.flaw b { color: var(--gold); } .stat.flaw.done b { color: var(--red); animation: pulse .8s infinite; }
.stat.ap s { display: inline-block; width: 6px; height: 10px; margin-right: 3px; background: var(--blue); border-radius: 1px; }
.stat.ap s.off { background: #23345c; }
@keyframes pulse { 50% { opacity: .45; } }
.hud-actions { display: flex; gap: 8px; }

/* ---------- 横幅 / Toast ---------- */
.banner-zone { position: fixed; top: 64px; left: 50%; transform: translateX(-50%); z-index: 60; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; width: min(92vw, 560px); }
.banner { padding: 9px 20px; border-radius: 8px; font-weight: bold; letter-spacing: 1px; text-align: center;
  background: linear-gradient(90deg, rgba(0, 132, 255, .18), rgba(0, 132, 255, .34), rgba(0, 132, 255, .18));
  border: 1px solid var(--line); box-shadow: 0 6px 24px rgba(0, 80, 180, .35); backdrop-filter: blur(6px); }
.banner.flaw { background: linear-gradient(90deg, rgba(245, 196, 81, .16), rgba(255, 77, 94, .3), rgba(245, 196, 81, .16)); border-color: rgba(245, 196, 81, .5); color: #ffe3a1; }
.banner.egg { background: linear-gradient(90deg, rgba(165, 139, 255, .15), rgba(0, 229, 168, .3), rgba(165, 139, 255, .15)); border-color: rgba(0, 229, 168, .4); }
.bnr-enter-active, .bnr-leave-active { transition: all .4s; }
.bnr-enter-from, .bnr-leave-to { opacity: 0; transform: translateY(-12px); }
.toast-zone { position: fixed; bottom: 86px; right: 18px; z-index: 70; display: flex; flex-direction: column; gap: 8px; }
.toast { padding: 10px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; max-width: 320px; box-shadow: 0 8px 24px rgba(0, 0, 0, .4); }
.toast.warn { border-color: rgba(255, 182, 72, .5); color: #ffd9a1; }
.toast.good { border-color: rgba(0, 229, 168, .5); }
.toast.flaw { border-color: rgba(245, 196, 81, .6); color: var(--gold); }
.tst-enter-active, .tst-leave-active { transition: all .3s; }
.tst-enter-from, .tst-leave-to { opacity: 0; transform: translateX(20px); }

/* ---------- 导航 ---------- */
.side-nav { width: 148px; padding: 14px 10px; border-right: 1px solid var(--line-dim); display: flex; flex-direction: column; gap: 4px; background: rgba(9, 14, 27, .8); }
.nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid transparent; border-radius: 8px; background: none; color: var(--txt-dim); cursor: pointer; font-size: 14px; position: relative; transition: all .15s; text-align: left; }
.nav-item:hover { color: var(--txt); background: rgba(0, 132, 255, .08); }
.nav-item.on { color: #fff; background: linear-gradient(90deg, rgba(0, 132, 255, .22), rgba(0, 132, 255, .06)); border-color: var(--line); }
.nav-item .ic { width: 18px; height: 18px; flex: none; }
.nav-badge { position: absolute; right: 8px; font-style: normal; font-size: 10px; background: var(--red); color: #fff; border-radius: 4px; padding: 1px 5px; font-family: var(--mono); animation: pulse 1s infinite; }
.bottom-nav { display: none; }

/* ---------- 通用控件 ---------- */
.btn { border: 1px solid var(--line); background: rgba(0, 132, 255, .1); color: var(--txt); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px; transition: all .15s; font-family: inherit; }
.btn:hover:not(:disabled) { background: rgba(0, 132, 255, .22); box-shadow: 0 0 12px rgba(0, 132, 255, .3); }
.btn:disabled { opacity: .38; cursor: not-allowed; }
.btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: bold; }
.btn.primary:hover:not(:disabled) { background: #1a90ff; }
.btn.ghost { background: transparent; }
.btn.warn { background: rgba(255, 182, 72, .16); border-color: rgba(255, 182, 72, .5); color: #ffd9a1; }
.btn.danger { background: linear-gradient(135deg, #ff4d5e, #c7324f); border-color: #ff6b78; color: #fff; font-weight: bold; }
.btn.sm { padding: 4px 10px; font-size: 12px; border-radius: 6px; }
.btn.big { padding: 12px 26px; font-size: 15px; width: 100%; }
.btn.icon-only { padding: 6px 8px; }
.btn.on { background: rgba(0, 132, 255, .3); }
.chip { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border: 1px solid var(--line-dim); border-radius: 20px; font-size: 12px; color: var(--txt-dim); background: rgba(15, 24, 46, .7); }
.chip.blue { color: var(--blue-2); border-color: var(--line); }
.chip.good { color: var(--green); border-color: rgba(0, 229, 168, .4); }
.chip.warn { color: #ffb648; border-color: rgba(255, 182, 72, .4); }
.chip.gold { color: var(--gold); border-color: rgba(245, 196, 81, .4); }
.chip.purple { color: var(--purple); border-color: rgba(165, 139, 255, .4); }
.chip.flaw { color: var(--gold); border-color: rgba(245, 196, 81, .5); background: rgba(245, 196, 81, .08); }
.chip.tiny { font-size: 11px; padding: 1px 8px; }
.chip.pick { cursor: pointer; color: var(--blue-2); }
.chip.pick:hover { border-color: var(--blue); background: rgba(0, 132, 255, .12); }
.seg { display: inline-flex; gap: 0; border: 1px solid var(--line-dim); border-radius: 8px; overflow: hidden; margin: 12px 0; }
.seg button { border: none; background: transparent; color: var(--txt-dim); padding: 7px 16px; cursor: pointer; font-size: 13px; font-family: inherit; }
.seg button.on { background: rgba(0, 132, 255, .2); color: #fff; }
.view-hd { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; border-bottom: 1px dashed var(--line-dim); padding-bottom: 12px; }
.view-hd h2 { font-size: 17px; letter-spacing: 2px; }
.view-hd h2::before { content: "▍"; color: var(--blue); }
.hd-chips { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.empty-state { text-align: center; padding: 34px 20px; border: 1px dashed var(--line-dim); border-radius: 12px; color: var(--txt-dim); display: flex; flex-direction: column; gap: 6px; align-items: center; }
.empty-state.small { padding: 18px; font-size: 13px; }
.empty-state.big-pad { margin: 40px auto; max-width: 520px; }
.empty-art { font-size: 40px; color: #22345c; letter-spacing: 4px; }
.empty-state b { color: var(--txt); }

/* ---------- 弹窗 ---------- */
.modal-mask { position: fixed; inset: 0; background: rgba(4, 8, 18, .72); backdrop-filter: blur(3px); z-index: 400; display: flex; align-items: center; justify-content: center; padding: 18px; }
.modal { width: min(94vw, 520px); max-height: 86vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #0e1730, #0a1122); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 24px 80px rgba(0, 40, 120, .5); overflow: hidden; }
.modal.wide { width: min(96vw, 760px); }
.modal-hd { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--line-dim); }
.modal-hd h3 { font-size: 15px; letter-spacing: 1px; }
.modal-hd h3::before { content: "◆ "; color: var(--blue); font-size: 12px; }
.modal-bd { padding: 16px; overflow: auto; }
.fade-enter-active, .fade-leave-active { transition: opacity .2s; }
.fade-enter-from, .fade-leave-to { opacity: 0; }

/* ---------- 场景地图 ---------- */
.map-view { position: relative; height: calc(100% - 0px); min-height: 480px; padding: 14px; }
.floorplan { position: absolute; inset: 14px; }
.floor-svg { width: 100%; height: 100%; }
.loc-node { position: absolute; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 2px; background: rgba(10, 18, 36, .88); border: 1px solid var(--line-dim); border-radius: 10px; padding: 7px 10px 6px; cursor: pointer; color: var(--txt); min-width: 86px; transition: all .18s; z-index: 2; font-family: inherit; }
.loc-node:hover { border-color: var(--blue); box-shadow: 0 0 16px rgba(0, 132, 255, .35); transform: translate(-50%, -52%); }
.loc-thumb { display: none; width: 72px; height: 40px; object-fit: cover; border-radius: 6px; margin-bottom: 2px; border: 1px solid rgba(0,132,255,.25); }
.loc-node:hover .loc-thumb { display: block; }
.loc-node.hot { box-shadow: 0 0 18px rgba(0, 229, 168, .28); }
.loc-node.warm { box-shadow: 0 0 14px rgba(245, 196, 81, .2); }
.loc-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 8px var(--blue); }
.loc-node.hot .loc-dot { background: var(--green); box-shadow: 0 0 10px var(--green); animation: pulse 1.6s infinite; }
.loc-node.warm .loc-dot { background: var(--gold); box-shadow: 0 0 8px var(--gold); }
.loc-node.cold .loc-dot { background: #43536f; box-shadow: none; }
.loc-name { font-size: 12.5px; font-weight: bold; letter-spacing: 1px; }
.loc-tier { font-size: 10px; color: var(--txt-dim); font-family: var(--mono); }
.loc-node.hot .loc-tier { color: var(--green); } .loc-node.warm .loc-tier { color: var(--gold); } .loc-node.cold .loc-tier { color: #5b6b8c; }
.search-panel { display: flex; flex-direction: column; gap: 14px; }
.scene-head { position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--line-dim); }
.scene-head img, .scene-head video, .scene-svg { display: block; width: 100%; height: 150px; object-fit: cover; }
.scene-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 20px 12px 8px; background: linear-gradient(transparent, rgba(5, 9, 20, .92)); }
.scene-cap b { display: block; font-size: 15px; letter-spacing: 2px; }
.scene-cap span { font-size: 12px; color: var(--txt-dim); }
.kw-row .lbl, .cd-row .lbl { font-size: 12px; color: var(--txt-dim); letter-spacing: 1px; display: block; margin-bottom: 6px; }
.kw-chips { display: flex; gap: 8px; flex-wrap: wrap; }
.kw-input { display: flex; gap: 10px; }
.kw-input input { flex: 1; background: #0a1224; border: 1px solid var(--line-dim); color: var(--txt); padding: 10px 14px; border-radius: 8px; font-size: 14px; outline: none; font-family: inherit; }
.kw-input input:focus { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(0, 132, 255, .15); }
.hint-line { font-size: 12px; color: var(--txt-dim); font-family: var(--mono); }
.clinic-draw { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
.draw-progress { font-family: var(--mono); color: var(--blue-2); }
.gain-card { border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: linear-gradient(160deg, rgba(0, 132, 255, .1), rgba(10, 16, 32, .6)); }
.gain-card.go { animation: gain .5s ease; }
@keyframes gain { 0% { transform: rotateY(90deg) scale(.9); opacity: 0; } 100% { transform: none; opacity: 1; } }
.gain-badge { display: inline-block; font-size: 11px; padding: 2px 10px; border-radius: 12px; margin-bottom: 8px; border: 1px solid; }
.gain-badge.public { color: var(--blue-2); border-color: var(--line); }
.gain-badge.limited { color: var(--purple); border-color: rgba(165, 139, 255, .5); }
.gain-badge.hidden { color: var(--gold); border-color: rgba(245, 196, 81, .5); }
.gain-badge.fake { color: var(--red); border-color: rgba(255, 77, 94, .5); }
.gain-badge.boss_flaw { color: #ffd9a1; border-color: rgba(255, 77, 94, .6); background: rgba(255, 77, 94, .12); animation: pulse 1.2s infinite; }
.gain-card h4 { font-size: 15px; margin-bottom: 6px; }
.gain-card p { font-size: 13px; color: var(--txt-dim); }
.gain-tags { margin-top: 8px; } .gain-tags i { font-style: normal; font-size: 11px; color: var(--blue-2); margin-right: 8px; }
.kc-gain { display: flex; gap: 12px; align-items: center; }
.kc-gain img { width: 64px; border-radius: 8px; }
.flip3d-enter-active { transition: all .45s; }

/* ---------- 对话流 ---------- */
.chat-view { display: flex; gap: 0; height: 100%; padding: 0; }
.roster { width: 132px; border-right: 1px solid var(--line-dim); overflow-y: auto; padding: 10px 6px; display: flex; flex-direction: column; gap: 4px; background: rgba(9, 14, 27, .7); }
.rost-item { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border: 1px solid transparent; background: none; border-radius: 8px; cursor: pointer; color: var(--txt-dim); font-family: inherit; text-align: left; }
.rost-item img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; object-position: center; border: 1px solid var(--line-dim); }
.rost-item.on { background: rgba(0, 132, 255, .14); border-color: var(--line); color: #fff; }
.rost-item.dm .rost-name { color: var(--cyan); }
.rost-name { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-main { flex: 1; display: flex; flex-direction: column; min-width: 0; position: relative; }
.chat-hd { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--line-dim); background: rgba(10, 16, 32, .6); }
.chat-hd img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: center; border: 1px solid var(--line); }
.chat-hd b { display: block; }
.chat-hd span { font-size: 11px; color: var(--txt-dim); display: block; }
.chat-list { flex: 1; overflow-y: auto; padding: 16px 18px 8px; display: flex; flex-direction: column; gap: 10px; }
.bubble-row { display: flex; gap: 8px; max-width: 86%; }
.bubble-row.me { align-self: flex-end; flex-direction: row-reverse; }
.bubble-row.dm { align-self: center; max-width: 94%; }
.bubble-row.sys { align-self: center; max-width: 94%; }
.b-ava { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; object-position: center; align-self: flex-end; }
.bubble { padding: 9px 13px; border-radius: 12px; background: var(--panel2); border: 1px solid var(--line-dim); font-size: 13.5px; word-break: break-word; position: relative; }
.me .bubble { background: linear-gradient(135deg, #0084ff, #0066d6); border: none; color: #fff; }
.dm .bubble { background: rgba(0, 132, 255, .1); border: 1px dashed var(--line); color: var(--blue-2); font-family: var(--mono); }
.sys .bubble { background: rgba(15, 24, 46, .7); border: 1px solid var(--line-dim); color: var(--txt-dim); font-size: 12.5px; }
.sys-tag { display: inline-block; font-size: 10px; color: var(--cyan); border: 1px solid rgba(111, 227, 255, .3); padding: 0 6px; border-radius: 8px; margin-right: 6px; font-family: var(--mono); }
.bubble-row.k-flaw .bubble { border-color: rgba(245, 196, 81, .55); color: #ffe3a1; }
.bubble-row.k-clue .bubble { border-color: rgba(0, 229, 168, .35); }
.bubble-row.k-memory .bubble { border-color: rgba(165, 139, 255, .4); }
.bubble-row.k-counsel .bubble { border-color: rgba(0, 229, 168, .5); }
.bubble-row.k-ambient .bubble { opacity: .75; }
.ambient-mark { display: block; margin-top: 4px; font-size: 10.5px; color: #5b6b8c; font-family: var(--mono); }
.heart .bubble { border: 1px dashed rgba(165, 139, 255, .6); background: rgba(165, 139, 255, .08); color: #cdbcff; }
.heart-tag { display: inline-block; font-size: 10px; color: var(--purple); border: 1px solid rgba(165, 139, 255, .4); padding: 0 6px; border-radius: 8px; margin-right: 6px; }
.chat-seed { text-align: center; color: #5b6b8c; font-size: 12px; padding: 30px 0; }
.chat-input { display: flex; gap: 10px; padding: 12px 16px; border-top: 1px solid var(--line-dim); background: rgba(10, 16, 32, .7); }
.chat-input input { flex: 1; background: #0a1224; border: 1px solid var(--line-dim); color: var(--txt); padding: 10px 14px; border-radius: 8px; outline: none; font-family: inherit; }
.chat-input input:focus { border-color: var(--blue); }

/* ---------- 弹幕层 ---------- */
.danmaku-layer { position: absolute; top: 52px; left: 0; right: 0; height: 40%; pointer-events: none; overflow: hidden; z-index: 5; }
.dm-item { position: absolute; left: 100%; white-space: nowrap; font-size: 13px; color: rgba(219, 230, 250, .85); padding: 3px 10px; border-radius: 14px; background: rgba(10, 18, 36, .55); animation: dmfly 6.5s linear forwards; }
.dm-item.sys { color: var(--cyan); border: 1px solid rgba(111, 227, 255, .25); font-family: var(--mono); }
.dm-item.gray { color: #8b9cc0; }
.dm-item.dm { color: var(--blue-2); }
@keyframes dmfly { from { transform: translateX(0); } to { transform: translateX(calc(-100vw - 60%)); } }

/* ---------- 证物袋 ---------- */
.clue-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 10px; }
.clue-card { position: relative; text-align: left; border: 1px solid var(--line-dim); background: linear-gradient(165deg, rgba(16, 26, 50, .9), rgba(10, 16, 32, .8)); border-radius: 10px; padding: 12px; cursor: pointer; color: var(--txt); display: flex; flex-direction: column; gap: 5px; font-family: inherit; transition: transform .15s, box-shadow .15s; overflow: hidden; }
.cc-thumb { position: relative; display: block; height: 72px; margin: -4px -4px 4px; border-radius: 8px; overflow: hidden; background: #0a1120; }
.cc-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.9); }
.clue-card.t-fake .cc-thumb { filter: grayscale(.35) hue-rotate(320deg); }
.clue-card.t-fake .cc-thumb::after { content: "伪"; position: absolute; top: 10px; right: 10px; font-size: 10px; letter-spacing: 2px; color: #ffb3bb; border: 1px solid rgba(255,77,94,.6); padding: 1px 6px; border-radius: 4px; background: rgba(20,8,12,.65); }
.clue-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 50, 140, .3); border-color: var(--line); }
.clue-card.t-boss { border-color: rgba(255, 77, 94, .6); box-shadow: inset 0 0 20px rgba(255, 77, 94, .08); }
.clue-card.t-hidden { border-color: rgba(245, 196, 81, .5); }
.clue-card.t-fake { border-style: dashed; border-color: rgba(255, 77, 94, .5); }
.clue-card.t-limited { border-color: rgba(165, 139, 255, .45); }
.cc-tier { font-size: 10px; letter-spacing: 1px; color: var(--txt-dim); font-family: var(--mono); }
.t-boss .cc-tier { color: #ff8c98; } .t-hidden .cc-tier { color: var(--gold); } .t-fake .cc-tier { color: var(--red); } .t-limited .cc-tier { color: var(--purple); }
.cc-name { font-weight: bold; font-size: 13.5px; }
.cc-tags i { font-style: normal; font-size: 11px; color: var(--blue-2); margin-right: 6px; }
.cc-flaw { position: absolute; right: 10px; top: 10px; color: var(--red); animation: pulse 1.2s infinite; }
.clue-detail .cd-row, .settings .cd-row { display: flex; gap: 10px; margin-bottom: 12px; align-items: flex-start; font-size: 13px; }
/* 证据影像层：clues.media 的静音循环视频（加载失败自动 v-if 降级为纯文本） */
.clue-detail .cd-media { margin: 0 0 12px; border: 1px solid rgba(0, 229, 168, .35); border-radius: 10px; overflow: hidden; background: #05080f; }
.clue-detail .cd-media video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
.clue-detail .cd-media figcaption { font-size: 11px; letter-spacing: 1px; color: var(--txt-dim); padding: 6px 10px; border-top: 1px solid rgba(0, 229, 168, .2); font-family: var(--mono); }
.clue-detail .lbl, .settings .lbl { flex: none; width: 64px; color: var(--txt-dim); font-size: 12px; padding-top: 2px; letter-spacing: 1px; }
.clue-detail p { flex: 1; }
.flavor { color: var(--txt-dim); font-style: italic; }
.exposed { color: var(--red); margin-top: 6px; }
.synth-list { display: flex; flex-direction: column; gap: 10px; max-width: 720px; }
.synth-card { border: 1px solid rgba(0, 229, 168, .4); background: linear-gradient(165deg, rgba(0, 229, 168, .07), rgba(10, 16, 32, .7)); border-radius: 12px; padding: 14px; }
.synth-top { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
.synth-card p { font-size: 13px; color: var(--txt-dim); }
.synth-refs { margin-top: 8px; display: flex; gap: 6px; flex-wrap: wrap; }

/* ---------- 知识卡 ---------- */
.kc-progress { height: 4px; background: #131f3a; border-radius: 2px; margin-bottom: 16px; overflow: hidden; }
.kc-bar { height: 100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); transition: width .5s; }
.kc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(158px, 1fr)); gap: 14px; }
.kc-card { position: relative; perspective: 800px; cursor: pointer; }
.kc-inner { position: relative; width: 100%; aspect-ratio: 3/4; transform-style: preserve-3d; transition: transform .6s; border-radius: 12px; }
.kc-inner.flipped { transform: rotateY(180deg); }
.kc-face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 12px; border: 1px solid var(--line-dim); display: flex; flex-direction: column; padding: 12px; overflow: hidden; }
.kc-front { background: linear-gradient(165deg, #0d2b5e, #081a3d 55%, #0a1226); border-color: rgba(0, 132, 255, .5); }
.kc-front::after { content: ""; position: absolute; inset: 6px; border: 1px solid rgba(0, 132, 255, .25); border-radius: 8px; pointer-events: none; }
.kc-crest { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; font-size: 16px; font-weight: 700; letter-spacing: 1px; color: #04122b; background: linear-gradient(135deg, #5ad1ff, #4da8ff); box-shadow: 0 0 16px rgba(77,168,255,.35); overflow: hidden; }
.kc-crest img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
.kc-detail-crest { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; margin: 0 0 12px; box-shadow: 0 0 18px rgba(77,168,255,.35); background: linear-gradient(135deg, #5ad1ff, #4da8ff); display: flex; align-items: center; justify-content: center; font-weight: 700; color: #04122b; }
.kc-detail-crest img { width: 100%; height: 100%; object-fit: cover; }
.kc-detail-crest.hue-flame { background: linear-gradient(135deg, #ff8a5c, #ff4d5e); }
.kc-detail-crest.hue-burn { background: linear-gradient(135deg, #c4b5ff, #a58bff); }
.kc-detail-crest.hue-goal { background: linear-gradient(135deg, #ffe08a, #f5c451); }
.kc-front.hue-flame .kc-crest { background: linear-gradient(135deg, #ff8a5c, #ff4d5e); color: #2a0c10; }
.kc-front.hue-voice .kc-crest { background: linear-gradient(135deg, #7eb6ff, #4da8ff); }
.kc-front.hue-work .kc-crest { background: linear-gradient(135deg, #9ec5ff, #6a8ec8); }
.kc-front.hue-focus .kc-crest { background: linear-gradient(135deg, #5ad1ff, #2fd2c8); }
.kc-front.hue-learn .kc-crest { background: linear-gradient(135deg, #80d0c7, #4da8ff); }
.kc-front.hue-burn .kc-crest { background: linear-gradient(135deg, #c4b5ff, #a58bff); color: #1a1230; }
.kc-front.hue-goal .kc-crest { background: linear-gradient(135deg, #ffe08a, #f5c451); color: #2a2208; }
.kc-front.hue-bound .kc-crest { background: linear-gradient(135deg, #6fe3ff, #4da8ff); }
.kc-front.hue-plan .kc-crest { background: linear-gradient(135deg, #d6c9ff, #a58bff); color: #1a1230; }
.kc-front.hue-flame { border-color: rgba(255, 120, 80, .5); }
.kc-front.hue-burn { border-color: rgba(165, 139, 255, .5); }
.kc-front.hue-goal { border-color: rgba(245, 196, 81, .5); }
.kc-credit { margin-top: 8px; font-size: 10px; letter-spacing: 1px; color: #5f7ea8; font-family: var(--mono); }
.kc-back { background: #0a1224; align-items: center; justify-content: center; gap: 8px; transform: rotateY(180deg); }
.kc-back img { width: 56%; opacity: .85; border-radius: 6px; }
.kc-back-label { font-size: 11px; color: #46598a; font-family: var(--mono); letter-spacing: 2px; }
.kc-tag { align-self: flex-start; font-size: 10px; color: var(--cyan); border: 1px solid rgba(111, 227, 255, .35); padding: 1px 8px; border-radius: 10px; margin-bottom: 8px; font-family: var(--mono); }
.kc-front h4 { font-size: 13.5px; line-height: 1.4; }
.kc-author { font-size: 11px; color: var(--blue-2); margin-top: 4px; }
.kc-quote { font-size: 11px; color: var(--txt-dim); margin-top: auto; line-height: 1.5; }
.kc-flipper { position: absolute; right: 8px; top: 8px; z-index: 2; width: 24px; height: 24px; border-radius: 50%; border: 1px solid var(--line-dim); background: rgba(10, 18, 36, .8); color: var(--blue-2); cursor: pointer; font-size: 13px; }
.kc-detail .kc-meta { font-size: 12px; color: var(--txt-dim); margin-bottom: 12px; }
.golden-list blockquote { border-left: 3px solid var(--blue); padding: 8px 12px; margin: 8px 0; background: rgba(0, 132, 255, .07); border-radius: 0 8px 8px 0; font-size: 13.5px; opacity: 0; animation: gqin .5s forwards; }
@keyframes gqin { from { opacity: 0; transform: translateX(-8px);} to { opacity: 1; } }
.kc-summary { font-size: 12.5px; color: var(--txt-dim); margin: 10px 0; }
.kc-detail .match { color: var(--gold); }
.kc-detail .match::before { content: "◈ "; }

/* ---------- 记忆对比 ---------- */
.mem-layout { display: flex; gap: 16px; }
.mem-list { width: 170px; flex: none; display: flex; flex-direction: column; gap: 6px; }
.mem-item { display: flex; gap: 8px; align-items: center; padding: 8px; background: none; border: 1px solid transparent; border-radius: 10px; cursor: pointer; color: var(--txt-dim); font-family: inherit; text-align: left; }
.mem-item img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; object-position: center; }
.mem-item.on { background: rgba(0, 132, 255, .12); border-color: var(--line); color: var(--txt); }
.mem-item b { font-size: 13px; display: block; }
.pips { display: flex; gap: 3px; }
.pips i { font-style: normal; font-size: 9.5px; font-family: var(--mono); border: 1px solid var(--line-dim); border-radius: 4px; padding: 0 4px; color: #4a5c85; }
.pips i.on { color: var(--blue-2); border-color: var(--line); background: rgba(0, 132, 255, .12); }
.heart-mark { display: block; font-size: 10px; color: var(--purple); font-style: normal; }
.mem-body { flex: 1; min-width: 0; }
.mem-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.diff-zone { margin-bottom: 12px; display: flex; flex-direction: column; gap: 6px; }
.diff-item { font-size: 12.5px; padding: 8px 12px; border-radius: 8px; background: rgba(255, 182, 72, .07); border: 1px solid rgba(255, 182, 72, .25); color: #ffd9a1; }
.diff-item.tamper { border-color: rgba(255, 77, 94, .55); background: rgba(255, 77, 94, .08); color: #ffb3bb; animation: tamperglow 2s infinite; }
@keyframes tamperglow { 50% { box-shadow: 0 0 14px rgba(255, 77, 94, .25); } }
.diff-tag { font-family: var(--mono); font-size: 10.5px; margin-right: 8px; opacity: .8; }
.compare { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.compare.single { grid-template-columns: 1fr; }
.cmp-col { border: 1px solid var(--line-dim); border-radius: 12px; padding: 12px; background: rgba(10, 16, 32, .55); }
.cmp-col h4 { font-size: 12px; letter-spacing: 2px; color: var(--txt-dim); margin-bottom: 10px; font-family: var(--mono); }
.heart-col { border-color: rgba(165, 139, 255, .3); }
.heart-col h4 { color: var(--purple); }
.mem-block { border: 1px solid var(--line-dim); border-radius: 8px; padding: 8px 10px; margin-bottom: 8px; background: rgba(15, 24, 46, .5); position: relative; }
.mem-block p { font-size: 13px; margin-top: 2px; }
.mb-time { font-family: var(--mono); font-size: 10.5px; color: var(--blue-2); }
.mb-int { float: right; font-size: 10px; padding: 0 6px; border-radius: 8px; border: 1px solid; }
.mem-block.edited { border-color: rgba(255, 182, 72, .45); }
.mem-block.edited .mb-int { color: #ffb648; border-color: rgba(255, 182, 72, .5); }
.mem-block.deleted { border-style: dashed; border-color: rgba(255, 77, 94, .5); opacity: .85; }
.mem-block.deleted .mb-int { color: var(--red); border-color: rgba(255, 77, 94, .5); }
.mem-block.heart { border-color: rgba(165, 139, 255, .45); background: rgba(165, 139, 255, .06); }
.mem-block.heart p { color: #cdbcff; }

/* ---------- 热搜 ---------- */
.feed-top { display: flex; gap: 20px; align-items: center; border: 1px solid var(--line-dim); border-radius: 12px; padding: 10px 16px; margin-bottom: 14px; background: rgba(10, 16, 32, .5); }
.heat-gauge svg { width: 110px; height: 68px; }
.gauge-num { font-family: var(--mono); font-size: 20px; font-weight: bold; }
.gauge-cap { font-size: 9px; fill: #5b6b8c; letter-spacing: 2px; }
.feed-top-note b { color: #ffb3bb; }
.feed-top-note p { font-size: 12.5px; color: var(--txt-dim); max-width: 560px; }
.post-list { display: flex; flex-direction: column; gap: 10px; }
.post { border: 1px solid var(--line-dim); border-radius: 12px; padding: 12px 14px; background: var(--panel2); transition: opacity .3s; }
.post.refuted { opacity: .62; }
.post.fake.refuted { border-color: rgba(0, 229, 168, .4); }
.post-hd { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
.post-hd h3 { font-size: 14px; color: var(--blue-2); }
.post-body { font-size: 13px; color: var(--txt); margin: 4px 0 8px; }
.post-ft { display: flex; align-items: center; gap: 10px; }
.heat-delta { font-family: var(--mono); font-size: 12px; color: var(--txt-dim); }
.heat-delta.hot { color: var(--red); }
.refute-panel .kc-pick { margin: 10px 0; }
.kc-pick { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; max-height: 300px; overflow: auto; }
.kc-pick-item { text-align: left; border: 1px solid var(--line-dim); background: rgba(15, 24, 46, .7); border-radius: 8px; padding: 8px 10px; cursor: pointer; color: var(--txt); font-family: inherit; display: flex; flex-direction: column; gap: 2px; }
.kc-pick-item b { font-size: 12.5px; }
.kc-pick-item span { font-size: 11px; color: var(--txt-dim); }
.kc-pick-item em { font-style: normal; font-size: 11px; color: var(--txt-dim); }
.kc-pick-item.match { border-color: rgba(0, 229, 168, .5); background: rgba(0, 229, 168, .07); }
.kc-pick-item.match em { color: var(--green); }
.kc-pick-item:hover { border-color: var(--blue); }
.match-preview { margin: 10px 0; padding: 8px 12px; border-radius: 8px; border: 1px solid; }
.match-preview.good { border-color: rgba(0, 229, 168, .5); color: var(--green); }
.match-preview.warn { border-color: rgba(255, 182, 72, .5); color: #ffb648; }

/* ---------- 圆桌投票 ---------- */
.vote-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.col-hd { font-size: 13px; color: var(--txt-dim); letter-spacing: 1px; margin-bottom: 10px; }
.suspect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 10px; }
.suspect-grid.small { grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); }
.suspect { border: 1px solid var(--line-dim); background: rgba(15, 24, 46, .7); border-radius: 10px; padding: 10px 6px; cursor: pointer; color: var(--txt); display: flex; flex-direction: column; align-items: center; gap: 4px; font-family: inherit; transition: all .15s; }
.suspect img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; object-position: center; border: 2px solid transparent; }
.suspect b { font-size: 12.5px; }
.suspect span { font-size: 10.5px; color: var(--txt-dim); }
.suspect:hover { border-color: var(--line); }
.suspect.on { border-color: var(--blue); background: rgba(0, 132, 255, .14); box-shadow: 0 0 14px rgba(0, 132, 255, .25); }
.suspect.on img { border-color: var(--blue); }
.suspect.healed img { filter: saturate(1.2) brightness(1.08) sepia(.16); box-shadow: 0 0 10px rgba(0, 229, 168, .4); }
.clinic-rec.ok .rec-hd img { filter: saturate(1.2) brightness(1.08) sepia(.16); }
.clinic-rec:not(.ok) .rec-hd img { filter: grayscale(.4) contrast(1.08); }
.rec-lines p.heart { text-shadow: 1px 0 0 rgba(0, 132, 255, .35), -1px 0 0 rgba(255, 90, 180, .28); }
.suspect.dm-slot { grid-column: span 2; border-style: dashed; opacity: .55; }
.suspect.dm-slot.unlocked { opacity: 1; border-color: rgba(255, 77, 94, .6); animation: dmglow 1.6s infinite; }
.suspect.dm-slot img { filter: drop-shadow(0 0 10px rgba(0, 132, 255, .5)); }
@keyframes dmglow { 50% { box-shadow: 0 0 20px rgba(255, 77, 94, .4); } }
.dm-btn-label { font-weight: bold; color: #ff8c98; letter-spacing: 2px; font-family: var(--mono); }
.ev-pool { display: flex; flex-direction: column; gap: 6px; max-height: 300px; overflow: auto; padding-right: 4px; }
.ev-item { text-align: left; border: 1px solid var(--line-dim); background: rgba(15, 24, 46, .6); border-radius: 8px; padding: 8px 12px; cursor: pointer; color: var(--txt); font-size: 13px; font-family: inherit; display: flex; gap: 8px; align-items: center; }
.ev-item.synth { border-color: rgba(0, 229, 168, .4); }
.ev-item.on { border-color: var(--blue); background: rgba(0, 132, 255, .15); }
.ev-item.on .ev-mark { color: var(--blue-2); }
.ev-mark { font-family: var(--mono); color: var(--txt-dim); }
.cov-preview { margin-top: 12px; font-size: 12.5px; color: var(--txt-dim); display: flex; flex-direction: column; gap: 6px; }
.cov-bar { height: 8px; background: #131f3a; border-radius: 4px; overflow: hidden; }
.cov-bar i { display: block; height: 100%; background: var(--blue); transition: width .4s; border-radius: 4px; }
.cov-bar i.good { background: var(--green); }
.cov-bar i.mid { background: var(--gold); }
.cov-bar.big { height: 14px; margin: 10px 0 16px; }
.vote-btn { margin-top: 14px; }
.vote-result p { margin-bottom: 6px; }
.ending-mini { border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin: 12px 0; background: rgba(0, 132, 255, .07); }
.ending-mini.good { border-color: rgba(0, 229, 168, .5); background: rgba(0, 229, 168, .06); }
.ending-mini.bad { border-color: rgba(255, 77, 94, .5); background: rgba(255, 77, 94, .07); }
.ending-mini.gold { border-color: rgba(245, 196, 81, .5); background: rgba(245, 196, 81, .07); }
.ending-mini.boss { border-color: rgba(165, 139, 255, .6); background: linear-gradient(150deg, rgba(0, 132, 255, .1), rgba(165, 139, 255, .12)); }
.ending-mini h3 { font-size: 17px; margin-bottom: 6px; letter-spacing: 2px; }

/* ---------- 心晴诊室 ---------- */
.counsel-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 18px; }
.counsel-step h4 { font-size: 13px; color: var(--txt-dim); margin-bottom: 10px; letter-spacing: 1px; }
.clinic-records { display: flex; flex-direction: column; gap: 12px; }
.clinic-rec { border: 1px solid var(--line-dim); border-radius: 12px; padding: 12px 14px; background: var(--panel2); }
.clinic-rec.ok { border-color: rgba(0, 229, 168, .4); }
.rec-hd { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.rec-hd img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; object-position: center; }
.rec-lines p { font-size: 13px; margin: 4px 0; color: var(--txt); }
.rec-lines p.heart { color: #cdbcff; }
.clinic-final { display: grid; grid-template-columns: 1fr 1.2fr; gap: 18px; }
.final-card { border: 1px solid var(--line); border-radius: 14px; padding: 22px; text-align: center; background: rgba(0, 132, 255, .07); }
.final-card.good { border-color: rgba(0, 229, 168, .5); }
.final-card.gold { border-color: rgba(245, 196, 81, .6); background: linear-gradient(160deg, rgba(245, 196, 81, .1), rgba(0, 132, 255, .08)); }
.final-card h3 { font-size: 18px; margin-bottom: 8px; letter-spacing: 2px; }
.final-count { font-family: var(--mono); color: var(--blue-2); margin-top: 10px; }
.golden-replay blockquote { border-left: 3px solid var(--gold); padding: 8px 12px; margin: 10px 0; background: rgba(245, 196, 81, .06); border-radius: 0 8px 8px 0; font-size: 13px; }
.golden-replay cite { display: block; font-size: 11px; color: var(--txt-dim); font-style: normal; margin-top: 4px; font-family: var(--mono); }

/* ---------- 结局 / 复盘 ---------- */
.ending-view { display: flex; align-items: center; justify-content: center; min-height: 100%; }
.ending-card { text-align: center; max-width: 560px; padding: 40px 30px; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(170deg, rgba(13, 22, 44, .95), rgba(8, 12, 24, .95)); position: relative; overflow: hidden; }
.ending-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(400px 200px at 50% 0%, rgba(0, 132, 255, .14), transparent); pointer-events: none; }
.ending-view.good .ending-card { border-color: rgba(0, 229, 168, .5); }
.ending-view.bad .ending-card { border-color: rgba(255, 77, 94, .5); }
.ending-view.gold .ending-card { border-color: rgba(245, 196, 81, .55); }
.ending-view.boss .ending-card { border-color: rgba(165, 139, 255, .6); }
.ending-tag { font-family: var(--mono); font-size: 11px; color: var(--cyan); letter-spacing: 4px; }
.ending-card h1 { font-size: 30px; letter-spacing: 6px; margin: 12px 0 16px; }
.ending-desc { color: var(--txt-dim); font-size: 14px; margin-bottom: 24px; }
.ending-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
.ending-actions .big { width: auto; }
.review-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.rv-card { border: 1px solid var(--line-dim); border-radius: 14px; padding: 16px; background: var(--panel2); }
.rv-card h3 { font-size: 14px; letter-spacing: 1px; margin-bottom: 12px; color: var(--blue-2); }
.tl-list { list-style: none; }
.tl-list li { display: flex; gap: 12px; padding: 7px 0; border-bottom: 1px dashed rgba(90, 130, 200, .12); }
.tl-time { flex: none; width: 92px; font-family: var(--mono); color: var(--cyan); font-size: 12px; padding-top: 2px; }
.tl-list p { font-size: 12.5px; color: var(--txt); }
.boss-card { cursor: pointer; border-color: rgba(165, 139, 255, .4); }
.boss-card:hover { box-shadow: 0 0 24px rgba(165, 139, 255, .2); }
.boss-visual { position: relative; border-radius: 10px; overflow: hidden; margin-bottom: 10px; }
.boss-visual img { width: 100%; height: 130px; object-fit: cover; opacity: .8; }
.boss-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(5, 9, 20, .35); font-weight: bold; letter-spacing: 2px; color: #cdbcff; }
.rv-card > p { font-size: 12.5px; color: var(--txt-dim); }
.flaw-list { list-style: none; }
.flaw-list li { padding: 6px 0; border-bottom: 1px dashed rgba(90, 130, 200, .12); font-size: 13px; }
.flaw-list li b { color: var(--txt-dim); }
.flaw-list li.got b { color: var(--gold); }
.flaw-list li span { display: block; font-size: 11.5px; color: var(--txt-dim); }
.clinic-recs-mini { display: flex; gap: 6px; flex-wrap: wrap; }
.credits { margin-top: 18px; border: 1px solid var(--line-dim); border-radius: 14px; padding: 18px; background: rgba(10, 16, 32, .6); }
.credits h3 { font-size: 14px; color: var(--blue-2); letter-spacing: 2px; margin-bottom: 12px; }
.credit-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.credit-col h4 { font-size: 12px; color: var(--txt-dim); margin-bottom: 8px; }
.credit-col h4.mt { margin-top: 12px; }
.credit-col p { font-size: 12.5px; margin-bottom: 6px; display: flex; justify-content: space-between; gap: 10px; }
.credit-col p span { color: var(--txt-dim); }
.kc-authors { color: var(--txt); }
.credit-small { margin-top: 14px; text-align: center; font-size: 11.5px; color: #4a5c85; font-family: var(--mono); letter-spacing: 1px; }
.demo-row { display: flex; gap: 8px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 10px; }

/* ---------- Boss 揭示演出 ---------- */
.boss-reveal { position: fixed; inset: 0; z-index: 80; background: linear-gradient(rgba(4, 7, 15, .7), rgba(4, 7, 15, .88)), url('/assets/images/scene_director_office.png') center/cover no-repeat, radial-gradient(800px 500px at 50% 40%, #0a1430, #04070f 75%); display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; cursor: pointer; }
.br-glitch { text-align: center; animation: glitchin .8s; }
@keyframes glitchin { 0% { opacity: 0; filter: blur(8px);} 60% { filter: blur(1px);} 100% { opacity: 1; } }
.br-sys { font-size: 60px; font-family: var(--mono); color: var(--blue-2); letter-spacing: 12px; animation: pulse .5s infinite; text-shadow: 0 0 30px rgba(0, 132, 255, .6); }
.br-check { margin-top: 18px; font-family: var(--mono); color: var(--txt-dim); letter-spacing: 2px; }
.br-check b { color: var(--red); }
.br-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; animation: holo 2s forwards; }
@keyframes holo { from { opacity: 0; } to { opacity: 1; } }
.br-holo img { height: 46vh; object-fit: contain; filter: drop-shadow(0 0 40px rgba(0, 132, 255, .45)); opacity: .92; mix-blend-mode: screen; animation: float 4s ease-in-out infinite; }
.br-holo.glitch img { animation: float 4s ease-in-out infinite, rgbshift .14s steps(2) infinite; }
@keyframes rgbshift {
  0% { transform: translate(0); filter: drop-shadow(-4px 0 #ff4d5e) drop-shadow(4px 0 #5ad1ff); }
  50% { transform: translate(3px, -2px); }
  100% { transform: translate(-3px, 1px); }
}
.boss-reveal.unmask .br-holo { opacity: 0; transition: opacity .85s ease; filter: blur(10px); }
.br-true { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; opacity: 0; transition: opacity .9s ease; }
.boss-reveal.unmask .br-true { opacity: 1; }
.br-true-cap { font-size: 11px; letter-spacing: 3px; color: #8aa4c8; font-family: var(--mono); }
.br-scan { position: absolute; inset: 0; background: repeating-linear-gradient(0deg, transparent 0 4px, rgba(0, 132, 255, .05) 4px 5px); pointer-events: none; }
.br-mono { position: absolute; bottom: 12vh; left: 50%; transform: translateX(-50%); width: min(90vw, 640px); text-align: center; }
.br-line { font-size: 16px; margin: 6px 0; color: var(--txt); letter-spacing: 1px; }
.br-line.done { opacity: .35; font-size: 13px; }
.br-line.live { color: #fff; text-shadow: 0 0 18px rgba(0, 132, 255, .5); font-size: 18px; }
.caret { animation: pulse .7s infinite; }
.br-title { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; background: rgba(4, 7, 15, .55); backdrop-filter: blur(2px); }
.br-title h2 { font-size: 34px; letter-spacing: 10px; color: #fff; text-shadow: 0 0 30px rgba(0, 132, 255, .7); }
.br-sub { color: var(--cyan); letter-spacing: 3px; }
.br-small { font-size: 12px; color: #4a5c85; font-family: var(--mono); }
.br-title .big { width: auto; }
.br-skip { position: absolute; right: 20px; bottom: 16px; font-size: 11px; color: #4a5c85; font-family: var(--mono); }

/* ---------- 移动端 ---------- */
@media (max-width: 860px) {
  body { font-size: 13.5px; }
  .hud { flex-wrap: wrap; gap: 8px; padding: 8px 10px; }
  .hud-stats { order: 3; width: 100%; justify-content: flex-start; gap: 6px; }
  .stat { min-width: 0; padding: 2px 8px; flex: 1; }
  .stat b { font-size: 12px; }
  .hud-title b { font-size: 13px; }
  .main { padding-bottom: 60px; }
  .side-nav { display: none; }
  .bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; height: 58px; display: flex; background: rgba(8, 13, 26, .97); border-top: 1px solid var(--line); z-index: 40; padding-bottom: env(safe-area-inset-bottom); }
  .bottom-nav .nav-item { flex: 1; flex-direction: column; gap: 2px; font-size: 10.5px; padding: 6px 2px; border-radius: 0; }
  .bottom-nav .nav-item span { font-size: 10px; }
  .view { padding: 14px 12px 30px; }
  .chat-view { flex-direction: column; }
  .roster { width: 100%; flex-direction: row; overflow-x: auto; border-right: none; border-bottom: 1px solid var(--line-dim); padding: 8px; }
  .rost-item { flex: none; }
  .compare { grid-template-columns: 1fr; }
  .vote-layout, .counsel-grid, .clinic-final, .review-grid, .credit-cols { grid-template-columns: 1fr; }
  .mem-layout { flex-direction: column; }
  .mem-list { width: 100%; flex-direction: row; overflow-x: auto; }
  .mem-item { flex: none; width: 150px; }
  .suspect.dm-slot { grid-column: span 1; }
  .modal-mask { padding: 10px; align-items: flex-end; }
  .modal { max-height: 88vh; width: 100vw; border-radius: 14px 14px 0 0; }
  .banner-zone { top: 108px; }
  .toast-zone { bottom: 66px; }
  .more-sheet { position: fixed; inset: 0; background: rgba(4, 8, 18, .6); z-index: 45; }
  .more-list { position: absolute; bottom: 64px; left: 10px; right: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 8px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .floorplan { inset: 10px; }
  .loc-node { min-width: 70px; padding: 5px 7px 4px; }
  .loc-name { font-size: 10.5px; }
  .loc-tier { font-size: 9px; }
  /* V31 增量（移动端） */
  .report-grid { grid-template-columns: 1fr !important; }
  .cz-body { flex-direction: column !important; }
  .bet-opts { grid-template-columns: 1fr 1fr !important; }
  .badge-wall { grid-template-columns: 1fr 1fr !important; }
  .dossier-body { flex-wrap: wrap; }
  .at-stage { width: 100vw !important; height: 100dvh !important; border-radius: 0 !important; }
  .elevator-cut .elv-lcd { width: 78vw !important; }
}
@media (max-width: 420px) {
  .stat i { font-size: 9px; }
  .hud-actions .btn.sm { padding: 4px 7px; font-size: 11px; }
}
