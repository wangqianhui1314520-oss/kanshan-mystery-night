# 《求真档案局·看山失踪夜》— 知乎凭证模板
# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# .env 已被 game/.gitignore 忽略，不会进版本库（凭证铁律：不落代码/前端/文档）。
# 所有变量仅服务端读取，前端永远拿不到。
#
# 来源：知乎开放平台控制台 https://developer.zhihu.com （黑客松赛道需勾选对应能力）

# ---------- 必填：内容接口 + 直答/用户资料 鉴权 ----------
# Access Secret（Bearer 凭证）：控制台「密钥管理」获取，格式形如 sk_xxxx
ZHIHU_ACCESS_SECRET=

# ---------- 必填（OAuth 登录可用时）：三件套 ----------
# 黑客松应用 App ID（公开配置，可回传前端拼授权 URL）
ZHIHU_OAUTH_APP_ID=
# 黑客松应用 App Key（仅后端，绝不进前端/日志）
ZHIHU_OAUTH_APP_KEY=
# 授权回调地址（必须与控制台「回调 URL」逐项完全一致，含路径/尾部斜杠）
ZHIHU_OAUTH_REDIRECT_URI=

# ---------- 可选：接口基地址（一般无需改） ----------
# 开放平台（鉴权：搜索/热榜/直答/用户资料）
ZHIHU_GAME_OPEN_API_BASE=https://developer.zhihu.com
# 开放 API（OAuth 换 token / 用户资料）
ZHIHU_OPENAPI_BASE=https://openapi.zhihu.com
# 内容接口（免鉴权：盐言故事/知乎知识）
ZHIHU_GAME_CONTENT_API_BASE=https://api.zhihu.com/km-indep-home/hackathon/v2

# ---------- 可选：额度/节流调优（默认见 gateway.health） ----------
# ZHIHU_GAME_QUOTA_ZHIDA=2
# ZHIHU_GAME_QUOTA_SEARCH=10
# ZHIHU_GAME_QUOTA_GSEARCH=10
# ZHIHU_GAME_QUOTA_HOT=2
# ZHIHU_GAME_HTTP_TIMEOUT=10
# ZHIHU_GAME_THROTTLE_SECONDS=1
# ZHIHU_GAME_TOPIC_WHITELIST=知乎,看山,盐言,悬疑,推理,剧本杀,职场,心理,情绪,倦怠,网络,舆情,谣言,辟谣,热搜,匿名,隐私,信息茧房,网暴,人工智能,AI,加班,打卡,内卷,流量,吃瓜
